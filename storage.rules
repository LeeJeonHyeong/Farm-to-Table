rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 셰프 프로필 사진: 본인만 쓰기, 전체 읽기
    match /images/chef-profile/{userId}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // 농가 프로필 사진: 본인만 쓰기, 전체 읽기
    match /images/farm-profile/{userId}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // 딜 사진: 인증된 유저만 쓰기, 전체 읽기
    match /images/deal/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
