// 주의: 이 프로젝트는 Firebase Storage를 아직 설정하지 않았다(콘솔에서 'Get Started'
// 미실행). 그래서 사진 업로드는 전부 실패하고 App.jsx의 base64 data URL 폴백으로
// Firestore에 저장된다. 이 파일도 배포된 적이 없다.
// Storage를 켠 뒤에 firebase.json에 아래를 추가하면 이 규칙이 적용된다:
//   "storage": { "rules": "storage.rules" }
// 켜지 않은 상태로 추가하면 firebase deploy 전체가 실패한다.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 실제 업로드 경로는 images/<uid>/<이름> 이다 (App.jsx ImageUpload의 storagePath):
    //   images/<uid>/chef_profile, images/<uid>/farm_profile,
    //   images/<uid>/cert, images/<uid>/crop_<dealId>
    // 이전 버전은 images/chef-profile/<uid>.jpg 를 매칭해 앱 경로와 전혀 맞지 않았다.
    match /images/{userId}/{fileName} {
      // 상대방(셰프↔농가)이 사진을 봐야 하므로 로그인 사용자에게는 열어둔다.
      // getDownloadURL이 발급하는 토큰 URL은 이 규칙과 무관하게 동작한다.
      allow read: if request.auth != null;

      // 업로드는 본인 경로에만. 업로드 산출물은 canvas webp 이다.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
