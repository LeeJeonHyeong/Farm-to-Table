rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 관리자를 서버에서 강제. App.jsx의 ADMIN_EMAIL 비교는 UI 표시 전용이므로
    // 규칙 파일에 이메일을 둬야 실제 권한이 강제된다 (규칙은 클라이언트로 전송되지 않음).
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'jhlove0490@nonghyup.com';
    }

    // storage 문서 키는 예외 없이 '<접두어>-<uid>' 형태다 (App.jsx의 *Key 헬퍼들).
    // matches()는 전체 문자열 매칭이므로 '-<uid>'로 끝나는 키만 통과한다.
    function isOwnKey(key) {
      return isSignedIn() && key.matches('.*-' + request.auth.uid);
    }

    match /storage/{key} {
      // 농가가 딜 작성자(셰프)의 프로필을 조회하는 경로만 교차 읽기가 필요하다.
      allow get: if isOwnKey(key)
                 || (isSignedIn() && key.matches('chef-profile-.*'))
                 || isAdmin();

      // 컬렉션 전체 조회는 관리자 사용자 목록 화면에서만 쓴다.
      // 비관리자는 조건이 key에 의존하므로 목록 조회가 거부되고 단일 get만 통과한다.
      allow list: if isAdmin();

      // storage.set은 항상 { value } 하나만 덮어쓴다 (firebase.js).
      allow create, update: if isOwnKey(key)
                            && request.resource.data.keys().hasOnly(['value'])
                            && request.resource.data.value is string
                            && request.resource.data.value.size() < 1048576;
    }

    match /chats/{chatId} {
      // 참여자 단위로 좁히지 못하는 상태다. 채팅 문서에는 messages만 있고 메시지에는
      // senderName/senderRole만 담기며 proposals에도 농가 uid가 없어서, 규칙이 대조할
      // uid가 데이터에 존재하지 않는다. 또 App.jsx가 chats 컬렉션 전체를 구독하므로
      // 문서 단위 제한을 걸면 목록 조회 자체가 거부된다.
      // 좁히려면 participants 필드 추가 + 구독 쿼리 필터링이 함께 필요하다.
      allow read, write: if isSignedIn();
    }

    match /deals/{dealId} {
      function isOwner() {
        return isSignedIn() && resource.data.createdBy == request.auth.uid;
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // 농가(딜 비소유자)가 정당하게 건드리는 필드만 나열한다. 여기 없는 필드는
      // 소유자 전용이 되므로 price·quantity·deliveryAddress·createdBy·
      // contractSignedChefAt, 그리고 depositPaidAt·balancePaidAt 결제 플래그가 잠긴다.
      function farmWritableOnly() {
        return changedKeys().hasOnly([
          'proposals',
          'inquiries',
          'deliveryStatus', 'shippedAt', 'courierName',
          'trackingNumber', 'shippedPhotoURL', 'shippedMemo',
          'contractSignedFarmAt',
          'chefRating', 'chefReview', 'chefRatedAt',
          'selectedProposalId', 'status', 'selectedAt'
        ]);
      }

      // 역제안 수락으로 matched까지만 갈 수 있고, done·closed 로는 못 넘긴다.
      function farmStatusOk() {
        return !changedKeys().hasAny(['status'])
               || request.resource.data.status == 'matched';
      }

      // 납품 신고(shipped)까지만. 수령 확인(delivered)은 셰프 몫이다.
      function farmDeliveryOk() {
        return !changedKeys().hasAny(['deliveryStatus'])
               || request.resource.data.deliveryStatus == 'shipped';
      }

      // 로그인 없이는 앱이 아무것도 렌더하지 않으므로 미인증 읽기를 열어둘 이유가 없다.
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isOwner()
                    || isAdmin()
                    || (isSignedIn()
                        && farmWritableOnly()
                        && farmStatusOk()
                        && farmDeliveryOk());

      allow delete: if isOwner() || isAdmin();
    }
  }
}
