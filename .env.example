# Farm-to-Table 환경변수 예시
# 이 파일을 복사해 .env.local 로 저장하고 실제 값을 채워주세요.
# cp .env.example .env.local

# ── Groq API (AI 자동 입력 / AI 매칭 점수) ──────────────────────
# https://console.groq.com 에서 무료 발급
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase (Firestore / Auth / Hosting) ───────────────────────
# https://console.firebase.google.com → 프로젝트 설정 → 앱 추가
VITE_FIREBASE_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxxxx

# ── 관리자 이메일 (샘플 데이터 초기화 권한) ─────────────────────
VITE_ADMIN_EMAIL=admin@example.com

# ── 토스페이먼츠 테스트 결제 ────────────────────────────────────
# https://developers.tosspayments.com → 내 개발 정보
VITE_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx

# ── DEV 전용 퀵 로그인 계정 (선택) ──────────────────────────────
# 설정 시 로그인 화면에 빠른 로그인 버튼이 표시됩니다 (DEV 환경만)
VITE_DEMO_CHEF_EMAIL=demo.chef@example.com
VITE_DEMO_CHEF_PW=your-chef-password
VITE_DEMO_FARM_EMAIL=demo.farm@example.com
VITE_DEMO_FARM_PW=your-farm-password
